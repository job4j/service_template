package middleware

import (
	"log/slog"
	"time"

	"{{.ModulePath}}/internal/observability/logctx"
	"github.com/gofiber/fiber/v2"
	"github.com/google/uuid"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/trace"
)

const RequestIDHeader = "X-Request-ID"

func RequestContext(base *slog.Logger) fiber.Handler {
	return func(c *fiber.Ctx) error {
		started := time.Now(); requestID := c.Get(RequestIDHeader); if requestID == "" { requestID = uuid.NewString() }
		c.Set(RequestIDHeader, requestID)
		ctx := logctx.WithRequestID(c.UserContext(), requestID)
		span := trace.SpanFromContext(ctx); span.SetAttributes(attribute.String("http.request_id", requestID))
		traceID := ""; if span.SpanContext().IsValid() { traceID = span.SpanContext().TraceID().String(); c.Set("X-Trace-ID", traceID) }
		logger := base.With("request_id", requestID, "trace_id", traceID); ctx = logctx.WithLogger(ctx, logger); c.SetUserContext(ctx)
		err := c.Next(); route := c.Path(); if c.Route() != nil && c.Route().Path != "" { route = c.Route().Path }
		logger.InfoContext(ctx, "http request", "method", c.Method(), "route", route, "status", c.Response().StatusCode(), "duration_ms", time.Since(started).Milliseconds(), "error", err)
		return err
	}
}
