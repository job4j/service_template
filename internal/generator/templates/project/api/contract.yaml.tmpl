openapi: 3.0.3
info:
  title: {{.ServiceName}} API
  version: 0.1.0
paths:
  /health:
    get:
      operationId: health
      summary: Check service health
      responses:
        "200":
          description: Service is healthy
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HealthResponse"
components:
  schemas:
    HealthResponse:
      type: object
      required:
        - status
      properties:
        status:
          type: string
          example: ok
      additionalProperties: false

